--========================================================
do
    local quickEnabled=false
    local quickHooked=false
    local function isMyPlot(plot)
        if not plot or not plot:IsA('Model') then return false end
        local sign=plot:FindFirstChild('PlotSign')
        local yourBase=sign and sign:FindFirstChild('YourBase')
        return yourBase~=nil and yourBase.Enabled==true
    end
    local function inMyPlot(inst)
        if not inst or not inst.Parent then return false end
        local node=inst.Parent
        for _=1,10 do
            if not node then return false end
            if node:IsA('Model') and node.Parent and node.Parent.Name=='Plots' then
                return isMyPlot(node)
            end
            node=node.Parent
        end
        return false
    end
    local function installQuickHook()
        if quickHooked then return true end
        if type(getrawmetatable)~='function' or type(setreadonly)~='function' then return false end
        local ok,mt=pcall(getrawmetatable,game)
        if not ok or not mt or type(mt.__newindex)~='function' then return false end
        local old=mt.__newindex
        if not pcall(setreadonly,mt,false) then return false end
        local nc=type(newcclosure)=='function' and newcclosure or function(f) return f end
        local hookOk=pcall(function()
            mt.__newindex=nc(function(self,key,value)
                if quickEnabled and key=='HoldDuration' and typeof(self)=='Instance'
                    and self:IsA('ProximityPrompt') and inMyPlot(self) then value=.1 end
                return old(self,key,value)
            end)
            quickHooked=true
        end)
        pcall(setreadonly,mt,true)
        return hookOk and quickHooked
    end
    local function applyExisting()
        local plots=workspace:FindFirstChild('Plots');if not plots then return end
        for _,plot in ipairs(plots:GetChildren()) do
            if isMyPlot(plot) then
                for i,obj in ipairs(plot:GetDescendants()) do
                    if obj:IsA('ProximityPrompt') then
                        pcall(function() obj.HoldDuration=.1 end)
                    end
                    if i%100==0 then task.wait() end
                end
            end
        end
    end
    H.QuickGrab=function(on)
        quickEnabled=on and true or false
        if quickEnabled then
            local hooked=installQuickHook()
            task.spawn(applyExisting)
            if not hooked then
                task.spawn(function()
                    while quickEnabled do applyExisting();task.wait(.5) end
                end)
            end
        end
    end
end
