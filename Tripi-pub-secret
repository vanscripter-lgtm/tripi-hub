local function applyHalloweenTheme(on)
    halloweenThemeEnabled=on and true or false
    _G.__TripiHalloweenTheme=halloweenThemeEnabled
    clearHalloweenAddedConnections()
    if not halloweenThemeEnabled then restoreRememberedHalloweenColors() end
    local target=halloweenThemeEnabled and HALLOWEEN_THEME or NORMAL_THEME
    for k,value in pairs(target) do C[k]=value end
    if _G.__TripiGrabSetTheme then pcall(_G.__TripiGrabSetTheme,halloweenThemeEnabled) end
    if _G.__TripiPlayerESPSetTheme then pcall(_G.__TripiPlayerESPSetTheme,halloweenThemeEnabled) end
    if _G.__TripiTrapESPSetTheme then pcall(_G.__TripiTrapESPSetTheme,halloweenThemeEnabled) end
    if halloweenThemeEnabled then startHalloweenBats() else clearHalloweenBats() end
    for _,root in ipairs(halloweenRoots()) do
        themeObject(root,target)
        for _,obj in ipairs(root:GetDescendants()) do themeObject(obj,target) end
        if halloweenThemeEnabled then
            halloweenAddedConns[#halloweenAddedConns+1]=root.DescendantAdded:Connect(function(obj)
                task.defer(function()
                    if halloweenThemeEnabled and obj and obj.Parent then
                        themeObject(obj,HALLOWEEN_THEME)
                    end
                end)
            end)
        end
    end
    -- Optimizer now follows the standard ON/OFF toggle and colors
    if _G.__PodiumESPCleanup then
