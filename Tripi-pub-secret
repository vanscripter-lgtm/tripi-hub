                task.wait(attempt==1 and .05 or .03)
                if tool and tool.Parent==char then H.CarpetSpeed(true);return end
            end
            held=false;H.CarpetSpeed(false)
        end)
    end
    _G.__TripiSelectFlyRelease=function() end
end

