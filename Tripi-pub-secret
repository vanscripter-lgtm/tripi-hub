local function remember(obj,keyName,value)
    local data=halloweenOriginal[obj]
    if not data then data={};halloweenOriginal[obj]=data end
    if data[keyName]==nil then data[keyName]=value end
end
local function recolorSequence(seq,target)
    local points={};local changed=false
    for _,point in ipairs(seq.Keypoints) do
        local color=point.Value
        local mapped=themedColor(color,target)
        if target==HALLOWEEN_THEME and not mapped and isPurpleAccent(color) then
            mapped=purpleToOrange(color)
        end
        points[#points+1]=ColorSequenceKeypoint.new(point.Time,mapped or color)
        if mapped then changed=true end
    end
    return changed and ColorSequence.new(points) or nil
end
local function themeObject(obj,target)
    pcall(function()
        if obj:IsA('UIGradient') then
            if target==HALLOWEEN_THEME then
                local newSeq=recolorSequence(obj.Color,target)
                if newSeq then
                    remember(obj,'GradientColor',obj.Color);obj.Color=newSeq
                end
            end
            return
        end
        if obj:IsA('UIStroke') then
            local old=obj.Color
            local mapped=themedColor(old,target)
            if target==HALLOWEEN_THEME and not mapped and isPurpleAccent(old) then
                remember(obj,'StrokeColor',old);mapped=purpleToOrange(old)
            end
            if mapped then obj.Color=mapped end
            return
        end
        if obj:IsA('GuiObject') then
            local old=obj.BackgroundColor3
            local mapped=themedColor(old,target)
            if target==HALLOWEEN_THEME and not mapped and isPurpleAccent(old) then
                remember(obj,'BackgroundColor3',old);mapped=purpleToOrange(old)
            end
            if mapped then obj.BackgroundColor3=mapped end
        end
        if obj:IsA('TextLabel') or obj:IsA('TextButton') or obj:IsA('TextBox') then
            local old=obj.TextColor3
            local mapped=themedColor(old,target)
            if target==HALLOWEEN_THEME and not mapped and isPurpleAccent(old) then
                remember(obj,'TextColor3',old);mapped=purpleToOrange(old)
            end
            if mapped then obj.TextColor3=mapped end
        end
        if obj:IsA('ScrollingFrame') then
            local old=obj.ScrollBarImageColor3
            local mapped=themedColor(old,target)
            if target==HALLOWEEN_THEME and not mapped and isPurpleAccent(old) then
                remember(obj,'ScrollBarImageColor3',old);mapped=purpleToOrange(old)
            end
            if mapped then obj.ScrollBarImageColor3=mapped end
        end
        if obj:IsA('ImageLabel') or obj:IsA('ImageButton') then
            local old=obj.ImageColor3
            local mapped=themedColor(old,target)
            if target==HALLOWEEN_THEME and not mapped and isPurpleAccent(old) then
                remember(obj,'ImageColor3',old);mapped=purpleToOrange(old)
            end
            if mapped then obj.ImageColor3=mapped end
        end
    end)
end
local function restoreRememberedHalloweenColors()
    for obj,data in pairs(halloweenOriginal) do
        if obj and obj.Parent then
            pcall(function()
                if data.GradientColor and obj:IsA('UIGradient') then obj.Color=data.GradientColor end
                if data.StrokeColor and obj:IsA('UIStroke') then obj.Color=data.StrokeColor end
                if data.BackgroundColor3 and obj:IsA('GuiObject') then obj.BackgroundColor3=data.BackgroundColor3 end
                if data.TextColor3 and (obj:IsA('TextLabel') or obj:IsA('TextButton') or obj:IsA('TextBox')) then
                    obj.TextColor3=data.TextColor3
                end
                if data.ScrollBarImageColor3 and obj:IsA('ScrollingFrame') then
                    obj.ScrollBarImageColor3=data.ScrollBarImageColor3
                end
                if data.ImageColor3 and (obj:IsA('ImageLabel') or obj:IsA('ImageButton')) then
                    obj.ImageColor3=data.ImageColor3
                end
            end)
        end
    end
    table.clear(halloweenOriginal)
end
local function halloweenRoots()
