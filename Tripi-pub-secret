do
    pcall(function()
        if _G.__TRIPI_BASE_XRAY_CLEANUP then _G.__TRIPI_BASE_XRAY_CLEANUP() end
    end)
    local XRAY_TRANSPARENCY=.72
    local enabled=false
    local changed={};local conns={};local generation=0
    local STRUCTURE_WORDS={wall=true,walls=true,glass=true,window=true,door=true,gate=true,
        roof=true,ceiling=true,frame=true,pillar=true,beam=true,fence=true,
        barrier=true,base=true,plot=true,building=true,house=true,structure=true}
    local IGNORE_WORDS={floor=true,ground=true,grass=true,road=true,spawn=true,button=true,
        pad=true,cash=true,collector=true,conveyor=true,belt=true,slot=true,
        stand=true,sign=true,text=true,gui=true,prompt=true}
    local function lower(v) return string.lower(tostring(v or '')) end
    local function hasWord(value,dict)
        value=lower(value)
        for w in pairs(dict) do if string.find(value,w,1,true) then return true end end
        return false
    end
    local function isCharacterOrTool(part)
        if part:FindFirstAncestorOfClass('Tool') then return true end
        local model=part:FindFirstAncestorOfClass('Model')
        return model and model:FindFirstChildOfClass('Humanoid')~=nil
    end
    local function shouldApply(part)
        if not part:IsA('BasePart') or isCharacterOrTool(part) then return false end
        local combined=lower(part.Name)
        local p=part.Parent;local depth=0
        while p and p~=workspace and depth<4 do
            combined=combined..' '..lower(p.Name);p=p.Parent;depth+=1
        end
        if hasWord(combined,IGNORE_WORDS) then return false end
        if hasWord(combined,STRUCTURE_WORDS) then return true end
        local s=part.Size
        if s.Y>=6 and (s.X<=4 or s.Z<=4) then return true end
        if s.Y<=5 and s.X>=15 and s.Z>=15 then
            local char=LP.Character
            local hrp=char and char:FindFirstChild('HumanoidRootPart')
            if not hrp or part.Position.Y>hrp.Position.Y+4 then return true end
        end
        return false
    end
    local function apply(part)
        if not enabled or not part or not part.Parent or not shouldApply(part) then return end
        if changed[part]==nil then changed[part]=part.LocalTransparencyModifier end
        part.LocalTransparencyModifier=math.max(part.LocalTransparencyModifier,XRAY_TRANSPARENCY)
    end
    local function restoreAll()
        local snapshot={}
        for part,old in pairs(changed) do snapshot[#snapshot+1]={part,old} end
        table.clear(changed)
        for i,item in ipairs(snapshot) do
            local part,old=item[1],item[2]
            if part and part.Parent then
                pcall(function() part.LocalTransparencyModifier=old or 0 end)
            end
            if i%80==0 then task.wait() end
        end
    end
    local function enable()
        generation+=1;local myGen=generation;enabled=true
        task.spawn(function()
            local plots=workspace:FindFirstChild('Plots');if not plots then return end
            for i,obj in ipairs(plots:GetDescendants()) do
                if not enabled or myGen~=generation then return end
                if obj:IsA('BasePart') then apply(obj) end
                if i%90==0 then task.wait() end
            end
        end)
    end
    local function disable()
        generation+=1;enabled=false;task.spawn(restoreAll)
    end
    local plots=workspace:FindFirstChild('Plots')
    if plots then
        conns[#conns+1]=plots.DescendantAdded:Connect(function(obj)
            if enabled and obj:IsA('BasePart') then
                task.defer(function() if enabled and obj.Parent then apply(obj) end end)
            end
        end)
        conns[#conns+1]=plots.DescendantRemoving:Connect(function(obj)
            if changed[obj]~=nil then changed[obj]=nil end
        end)
    end
    H.XRay=function(on) if on then enable() else disable() end end
    _G.__TRIPI_BASE_XRAY_CLEANUP=function()
        generation+=1;enabled=false;pcall(restoreAll)
        for _,c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        table.clear(conns)
    end
end
