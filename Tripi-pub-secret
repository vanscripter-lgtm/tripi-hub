        {name="Santa's Sleigh",aliases={"santa's sleigh",'santa sleigh','fly santa sleigh','fly santa sleight','santas sleigh','santasleigh','sleigh','sleight'},tokens={'santa','sleigh'}},
        {name="Witch's Broom",aliases={"witch's broom",'witch broom','witchs broom','fly sekop penyihir','broom','witchbroom','flying broom','magic broom'},tokens={'witch','broom'}},
        {name="Cupid's Wings",aliases={"cupid's wings",'cupid wings','cupids wings','fly saya cupid','cupid','wings','cupidwings'},tokens={'cupid','wing'}},
        {name='Wave Rider',aliases={'wave rider','fly wave rider','waverider','wave board','surf','surfboard'},tokens={'wave','rider'}},
        {name='Heart Balloon',aliases={'heart balloon','fly heart balloon','heartballoon','balloon heart'},tokens={'heart','balloon'}}
    }
    local selected=catalog[1].name
    local held=false
    local function norm(v)
        return string.lower(tostring(v or '')):gsub('’',"'"):gsub('%s+',' '):gsub('^%s+',''):gsub('%s+$','')
    end
    local function findEntry(name)
        local wanted=norm(name)
        for _,e in ipairs(catalog) do if norm(e.name)==wanted then return e end end
    end
    pcall(function()
        if type(readfile)=='function' then
            local e=findEntry(readfile(FILE));if e then selected=e.name end
        end
    end)
    local function save()
        if type(writefile)=='function' then pcall(function() writefile(FILE,selected) end) end
    end
    local function tools()
        local list={};local seen={}
        local function scan(container)
            if not container then return end
            for _,o in ipairs(container:GetChildren()) do
                if o:IsA('Tool') then
                    local k=norm(o.Name)
                    if not seen[k] then seen[k]=true;list[#list+1]=o end
                end
            end
        end
        scan(LP:FindFirstChildOfClass('Backpack'));scan(LP.Character)
        return list
    end
    local function selectedTool()
        local e=findEntry(selected)
        if not e then return nil end
        local candidates=tools()
        for _,tool in ipairs(candidates) do
            local tn=norm(tool.Name):gsub('[_%-%./]',' ')
            for _,a in ipairs(e.aliases) do
                local an=norm(a):gsub('[_%-%./]',' ')
                if tn==an or tn:find(an,1,true) or an:find(tn,1,true) then return tool end
            end
        end
        for _,tool in ipairs(candidates) do
            local tn=norm(tool.Name):gsub('[_%-%./]',' ')
            local hits=0
            for _,token in ipairs(e.tokens or {}) do
                if tn:find(norm(token),1,true) then hits+=1 end
            end
            if hits>0 then
                if e.name=='Flying Carpet' or e.name=="Witch's Broom" or e.name=='Heart Balloon' or hits>=2 then
                    return tool
                end
            end
        end
    end
