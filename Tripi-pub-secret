-- AUTO KICK ("you stole")
--========================================================
local autoKickEnabled=false
local autoKickReady=false
local watchedKickText=setmetatable({},{__mode='k'})
local function kickTextObject(o)
    return o:IsA('TextLabel') or o:IsA('TextButton') or o:IsA('TextBox')
end
local function stoleText(s)
    return type(s)=='string' and s:lower():find('you stole',1,true)~=nil
end
local function kickNow()
    if not autoKickEnabled then return end
    local ok=pcall(function() game:Shutdown() end)
    if not ok then pcall(function() LP:Kick('') end) end
end
local function watchKickText(o)
    if watchedKickText[o] or not kickTextObject(o) then return end
    watchedKickText[o]=true
    if autoKickEnabled and stoleText(o.Text) then kickNow();return end
    o:GetPropertyChangedSignal('Text'):Connect(function()
        if autoKickEnabled and stoleText(o.Text) then kickNow() end
    end)
end
local function initAutoKick()
    if autoKickReady then return end
    autoKickReady=true
    local pg=LP:FindFirstChildOfClass('PlayerGui') or LP:WaitForChild('PlayerGui')
    for _,o in ipairs(pg:GetDescendants()) do if kickTextObject(o) then watchKickText(o) end end
    pg.DescendantAdded:Connect(function(o) if kickTextObject(o) then watchKickText(o) end end)
end
H.AutoKick=function(on)
    initAutoKick();autoKickEnabled=on and true or false
    if autoKickEnabled then
        local pg=LP:FindFirstChildOfClass('PlayerGui')
        if pg then
            for _,o in ipairs(pg:GetDescendants()) do
                if kickTextObject(o) and stoleText(o.Text) then kickNow();break end
            end
        end
    end
end

