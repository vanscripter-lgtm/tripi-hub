-- TRIPI JOB ID LIVE TRACKER - INTEGRATED
-- COPY button: clipboard + Discord; numbered 1-8 list updates on JOIN/LEAVE.
-- Separate webhook; existing Steal Tracker webhook remains unchanged.
--========================================================
do
    pcall(function()
        if type(_G.__TRIPI_JOB_LIVE_CLEANUP)=="function" then
            _G.__TRIPI_JOB_LIVE_CLEANUP()
        end
    end)

    local WEBHOOK_URL="https://discord.com/api/webhooks/1567543805127696465/3a4wl0HCFyyN0ZgDucykTP2SxVy2vCbJVco2SJwJY4Mn6qK8gzYpvS1g2NHJ1L7mb6Fp"
    local active=true
    local tracking=false
    local messageId=nil
    local copiedBy="-"
    local departing={}
    local connections={}
    local pending=false
    local sending=false

    local function playerText(plr)
        local display=tostring(plr.DisplayName or plr.Name):gsub("[`\r\n]"," ")
        local user=tostring(plr.Name):gsub("[`\r\n]"," ")
        return display.." (@"..user..")"
    end

    local function requestFunction()
        local env=(type(getgenv)=="function" and getgenv()) or _G
        return env.request or env.http_request
            or (env.syn and env.syn.request)
            or (env.http and env.http.request)
            or (env.fluxus and env.fluxus.request)
            or request or http_request
    end

    local function shorten(s,limit)
        s=tostring(s or "-")
        if s=="" then return "-" end
        if #s>limit then return s:sub(1,limit-3).."..." end
        return s
    end

    local function currentPlayers()
        local players={}
        for _,plr in ipairs(Players:GetPlayers()) do
            if not departing[plr.UserId] then
                players[#players+1]=plr
            end
        end
        -- Keep Roblox's list order, so newcomers appear as the next numbered player.
        return players
    end

    local function buildPayload(mentionEveryone)
        local online=currentPlayers()
        local MAX_PLAYERS=8
        local names={}
        for i=1,math.min(#online,MAX_PLAYERS) do
            names[#names+1]=tostring(i)..". "..playerText(online[i])
        end
        local payload={
            username="TRIPI Job ID Tracker",
            -- Ping @everyone only on the first POST; PATCH edits never ping again.
            allowed_mentions={parse=mentionEveryone and {"everyone"} or {}},
            embeds={{
                title="TRIPI LIVE SERVER INFORMATION",
                color=11358955,
                fields={
                    {name="Copied By",value=shorten(copiedBy,1024),inline=false},
                    {name="Players",value=tostring(math.min(#online,MAX_PLAYERS)).."/"..tostring(MAX_PLAYERS),inline=true},
                    {name="Place ID",value="`"..tostring(game.PlaceId).."`",inline=true},
                    {name="Job ID",value="`"..tostring(game.JobId).."`",inline=false},
                    {name="Player List",value=shorten(table.concat(names,"\n"),1024),inline=false}
                },
                footer={text="TRIPI | Updated "..os.date("%H:%M:%S")}
            }}
        }
        if mentionEveryone then
            payload.content="@everyone"
        end
        return payload
    end

    local function callDiscord(method,url,data)
        local req=requestFunction()
        if type(req)~="function" then
            warn("[TRIPI JOB ID] HTTP request tidak tersedia")
            return false,nil
        end
        local ok,response=pcall(function()
            return req({
                Url=url,
                Method=method,
                Headers={["Content-Type"]="application/json"},
                Body=HttpService:JSONEncode(data)
            })
        end)
        if not ok or type(response)~="table" then
            warn("[TRIPI JOB ID] Request Discord gagal:",response)
            return false,nil
        end
        local status=tonumber(response.StatusCode or response.Status or response.status_code)
        if status and (status<200 or status>=300) then
            warn("[TRIPI JOB ID] Discord HTTP:",status)
            return false,response
        end
        return true,response
    end

    local function sendUpdate()
        if not active or not tracking then return end
        if messageId then
            local ok=callDiscord("PATCH",WEBHOOK_URL.."/messages/"..messageId,buildPayload(false))
            if not ok then warn("[TRIPI JOB ID] Gagal update pesan Discord") end
            return
        end

        -- wait=true requests the message ID for future PATCH edits.
        local ok,response=callDiscord("POST",WEBHOOK_URL.."?wait=true",buildPayload(true))
        if not ok then return end
        local raw=response.Body or response.body
        if type(raw)=="string" and raw~="" then
            local parsedOK,data=pcall(function() return HttpService:JSONDecode(raw) end)
            if parsedOK and type(data)=="table" and data.id then
                messageId=tostring(data.id)
            end
        end
        if not messageId then
            -- Do not repost blindly: Discord might already have received it.
            tracking=false
            warn("[TRIPI JOB ID] Message ID tidak diterima; live update berhenti")
        end
    end

    local function queueUpdate()
        if not active or not tracking then return end
        pending=true
        if sending then return end
        sending=true
        task.spawn(function()
            repeat
                task.wait(1.4)
                if not active or not tracking then break end
                pending=false
                sendUpdate()
            until not pending
            sending=false
        end)
    end

    _G.__TRIPI_JOB_LIVE_COPY=function()
        if not active then return end
        copiedBy=playerText(LP)
        if not tracking then
            tracking=true
        end
        queueUpdate()
    end

    connections[#connections+1]=Players.PlayerAdded:Connect(function(plr)
        departing[plr.UserId]=nil
        if tracking then
            queueUpdate()
        end
    end)
    connections[#connections+1]=Players.PlayerRemoving:Connect(function(plr)
        departing[plr.UserId]=true
        if tracking then
            queueUpdate()
        end
    end)

    _G.__TRIPI_JOB_LIVE_CLEANUP=function()
        active=false
        tracking=false
        for _,conn in ipairs(connections) do
            pcall(function() conn:Disconnect() end)
        end
        table.clear(connections)
        _G.__TRIPI_JOB_LIVE_COPY=nil
    end
end

