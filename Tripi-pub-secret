    _G.__TripiGetSelectedFly=function() return selected end
    _G.__TripiSetSelectedFly=function(name)
        local e=findEntry(name);if not e then return false end
        selected=e.name;save();return true
    end
    _G.__TripiSelectedFlyOwned=function() return selectedTool()~=nil end
    _G.__TripiSelectFlyPress=function()
        if held then held=false;H.CarpetSpeed(false);return end
        held=true
