-- TRIPI TRAP ESP
--========================================================
do
    local Workspace=game:GetService('Workspace')
    local trapRunning=true;local trapEnabled=false
    local trapColorNormal=Color3.fromRGB(170,104,255)
    local trapColorHalloween=Color3.fromRGB(255,132,24)
    local trapColor=trapColorNormal
    local trapFound={};local trapConnections={};local trapScanBusy=false
    local candidateFolders={toolsadds=true,traps=true,trap=true,items=true,placeditems=true,
        deployables=true,objects=true,map=true,workspace=true}
    local forbiddenFolders={replicatedstorage=true,serverstorage=true,starterpack=true,
        startergui=true,backpack=true,inventory=true,display=true,displays=true,
        showcase=true,stock=true,tools=true}
    local function trapConnect(signal,fn)
        local c=signal:Connect(fn);trapConnections[#trapConnections+1]=c;return c
    end
    local function trapInCharacter(o)
        local p=o.Parent
        while p and p~=Workspace do
            if p:IsA('Model') and Players:GetPlayerFromCharacter(p) then return true end
            if p:IsA('Tool') or p:IsA('Accessory') then return true end
            p=p.Parent
        end
        return false
    end
    local function trapAcceptableLocation(o)
        local p=o.Parent;local known=false
        while p and p~=Workspace do
            local pn=string.lower(p.Name)
            if forbiddenFolders[pn] then return false,false end
            if candidateFolders[pn] then known=true end
            p=p.Parent
        end
        return true,known
    end
    local function trapKindByName(obj)
        if not (obj:IsA('BasePart') or obj:IsA('Model')) then return nil end
        if obj:IsA('Model') and obj:FindFirstChildOfClass('Humanoid') then return nil end
        if trapInCharacter(obj) then return nil end
        local ok,knownFolder=trapAcceptableLocation(obj)
        if not ok then return nil end
        local n=string.lower(obj.Name):gsub('[ _%-]','')
        if n:match('^subspacetripmine') or n:match('^subspacemine') then return 'Mine' end
        if n=='trap' or n=='beartrap' or n=='placedtrap' or n=='normaltrap' or n=='freezetrap' then
            return 'Trap'
        end
        if n:match('^placedbeartrap') or n:match('^placedfreezetrap') then return 'Trap' end
        if knownFolder and (n:match('^trap[%w]+$') or n:match('^beartrap[%w]+$'))
            and not n:find('button',1,true) and not n:find('spawn',1,true)
            and not n:find('preview',1,true) and not n:find('trigger',1,true)
            and not n:find('hitbox',1,true) then return 'Trap' end
    end
    local function trapInsideRootCandidate(obj)
        local p=obj.Parent
        while p and p~=Workspace do
            if p:IsA('Model') and trapKindByName(p) then return true end
            p=p.Parent
        end
        return false
    end
    local function trapPartOf(root)
        if root:IsA('BasePart') then return root end
        if root:IsA('Model') then
            return root.PrimaryPart or root:FindFirstChildWhichIsA('BasePart',true)
        end
    end
    local function trapRemove(root)
        local f=trapFound[root];if not f then return end
        trapFound[root]=nil
        pcall(function() f.box:Destroy() end)
        pcall(function() f.outline:Destroy() end)
        pcall(function() f.billboard:Destroy() end)
    end
    local function trapRecolor()
        for _,f in pairs(trapFound) do
            if f.box then f.box.Color3=trapColor end
            if f.outline then f.outline.Color3=trapColor end
            if f.label then f.label.TextColor3=trapColor end
        end
    end
    local function trapAdd(root,kind)
        if trapFound[root] or not trapEnabled or not root:IsDescendantOf(Workspace) then return end
        if trapInsideRootCandidate(root) then return end
        local part=trapPartOf(root);if not part then return end
        local box=Instance.new('BoxHandleAdornment')
        box.Name='TRIPI_TrapESP_Box';box.Adornee=part
        box.Size=part.Size+Vector3.new(.5,.5,.5)
        box.AlwaysOnTop=true;box.ZIndex=4
        box.Color3=trapColor;box.Transparency=.7;box.Parent=part
        local outline=Instance.new('SelectionBox')
        outline.Name='TRIPI_TrapESP_Outline';outline.Adornee=part
        outline.Color3=trapColor;outline.SurfaceTransparency=1
        outline.LineThickness=.05;outline.Parent=part
        local billboard=Instance.new('BillboardGui')
        billboard.Name='TRIPI_TrapESP_Text';billboard.Adornee=part
        billboard.AlwaysOnTop=true;billboard.MaxDistance=2500
        billboard.Size=UDim2.fromOffset(118,30)
        billboard.StudsOffsetWorldSpace=Vector3.new(0,2.2,0)
        billboard.LightInfluence=0;billboard.Parent=LP:WaitForChild('PlayerGui')
        local top=Instance.new('TextLabel')
        top.Size=UDim2.new(1,0,0,15);top.BackgroundTransparency=1
        top.Font=Enum.Font.GothamBold;top.TextSize=11
        top.TextColor3=trapColor;top.TextStrokeColor3=Color3.new(0,0,0)
        top.TextStrokeTransparency=0
        top.Text=(kind=='Trap') and 'TRAP' or 'SUBSPACE MINE'
        top.Parent=billboard
        local dist=Instance.new('TextLabel')
        dist.Size=UDim2.new(1,0,0,13);dist.Position=UDim2.fromOffset(0,15)
        dist.BackgroundTransparency=1;dist.Font=Enum.Font.GothamMedium
        dist.TextSize=10;dist.TextColor3=Color3.fromRGB(230,230,230)
        dist.TextStrokeTransparency=.2;dist.Text='';dist.Parent=billboard
        trapFound[root]={kind=kind,part=part,box=box,outline=outline,
            billboard=billboard,label=top,distance=dist}
    end
    local function trapConsider(obj)
        if not trapRunning or not trapEnabled then return end
        local kind=trapKindByName(obj)
        if kind then trapAdd(obj,kind) end
    end
    local function trapRescan()
        if not trapEnabled or trapScanBusy then return end
        trapScanBusy=true
        task.spawn(function()
            local ok=pcall(function()
                local toolsAdds=Workspace:FindFirstChild('ToolsAdds')
                if toolsAdds then
                    for i,o in ipairs(toolsAdds:GetDescendants()) do
                        if not trapEnabled then break end
                        trapConsider(o)
                        if i%120==0 then task.wait() end
                    end
                end
                for name in pairs(candidateFolders) do
                    if name~='toolsadds' then
                        for _,child in ipairs(Workspace:GetChildren()) do
                            if string.lower(child.Name)==name then
                                for i,obj in ipairs(child:GetDescendants()) do
                                    if not trapEnabled then break end
                                    trapConsider(obj)
                                    if i%150==0 then task.wait() end
                                end
                            end
                        end
                    end
                end
            end)
            trapScanBusy=false
            if not ok then warn('[TRIPI] Trap ESP rescan gagal') end
        end)
    end
    local function trapFullScan()
        if not trapEnabled or trapScanBusy then return end
        trapScanBusy=true
        task.spawn(function()
            local ok=pcall(function()
                for i,o in ipairs(Workspace:GetDescendants()) do
                    if not trapEnabled then break end
                    trapConsider(o)
                    if i%350==0 then task.wait() end
                end
            end)
            trapScanBusy=false
            if not ok then warn('[TRIPI] Trap ESP full scan gagal') end
        end)
    end
    local function trapClearVisuals()
        local roots={}
        for root in pairs(trapFound) do roots[#roots+1]=root end
        for _,root in ipairs(roots) do trapRemove(root) end
    end
    H.TrapESP=function(on)
        trapEnabled=on and true or false
        if trapEnabled then trapFullScan() else trapClearVisuals() end
    end
    _G.__TripiTrapESPSetTheme=function(halloween)
        trapColor=halloween and trapColorHalloween or trapColorNormal
        trapRecolor()
    end
    trapConnect(Workspace.DescendantAdded,function(o)
        if trapEnabled then task.defer(trapConsider,o) end
    end)
    trapConnect(Workspace.DescendantRemoving,function(o)
        if trapFound[o] then trapRemove(o) end
    end)
    task.spawn(function()
        local lastScan=0;local lastFull=0
        while trapRunning do
            task.wait(.6)
            if trapEnabled then
                local char=LP.Character
                local hrp=char and char:FindFirstChild('HumanoidRootPart')
                local roots={}
                for root,f in pairs(trapFound) do roots[#roots+1]={root,f} end
                for _,item in ipairs(roots) do
                    local root,f=item[1],item[2]
                    if not root.Parent or not root:IsDescendantOf(Workspace)
                        or not f.part or not f.part.Parent or trapInsideRootCandidate(root) then
                        trapRemove(root)
                    elseif hrp then
                        local meters=math.floor((hrp.Position-f.part.Position).Magnitude+.5)
                        f.distance.Text=tostring(meters)..' studs'
                    else f.distance.Text='' end
                end
                local now=os.clock()
                if now-lastScan>2.2 then lastScan=now;trapRescan() end
                if now-lastFull>14 then lastFull=now;trapFullScan() end
            end
        end
    end)
end

