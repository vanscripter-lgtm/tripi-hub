local function sameColor(a,b)
    return math.abs(a.R-b.R)<.004 and math.abs(a.G-b.G)<.004
        and math.abs(a.B-b.B)<.004
end
local function isOrangeAccent(color)
    local h,s,v=Color3.toHSV(color)
    return s>.20 and v>.10 and h>=.015 and h<=.14
end
local function orangeToPurple(color)
    local _,s,v=Color3.toHSV(color)
    return Color3.fromHSV(.765,math.clamp(math.max(s,.55),0,1),
        math.clamp(math.max(v,.25),0,1))
end
local NORMAL_ORANGE_TO_PURPLE={
    {Color3.fromRGB(255,122,24),Color3.fromRGB(174,82,235)},
    {Color3.fromRGB(230,91,0),Color3.fromRGB(128,53,190)},
    {Color3.fromRGB(255,175,75),Color3.fromRGB(205,145,244)},
    {Color3.fromRGB(90,52,20),Color3.fromRGB(92,47,132)},
    {Color3.fromRGB(39,24,14),Color3.fromRGB(37,18,48)},
    {Color3.fromRGB(120,72,26),Color3.fromRGB(111,56,151)},
    {Color3.fromRGB(18,15,12),Color3.fromRGB(23,14,35)},
    {Color3.fromRGB(14,14,14),Color3.fromRGB(14,9,22)},
    {Color3.fromRGB(10,10,10),Color3.fromRGB(8,6,13)},
    {Color3.fromRGB(150,82,25),Color3.fromRGB(92,47,132)},
    {Color3.fromRGB(23,129,28),Color3.fromRGB(132,61,191)},
    {Color3.fromRGB(35,162,41),Color3.fromRGB(174,82,235)}
}
local function themedColor(color,target)
    if target==NORMAL_THEME then
        for _,pair in ipairs(NORMAL_ORANGE_TO_PURPLE) do
            if sameColor(color,pair[1]) or sameColor(color,pair[2]) then return pair[2] end
        end
        if isOrangeAccent(color) then return orangeToPurple(color) end
    end
    for k,normal in pairs(NORMAL_THEME) do
        if sameColor(color,normal) or sameColor(color,HALLOWEEN_THEME[k]) then
            return target[k]
        end
    end
    for i,normal in ipairs(EXTRA_NORMAL) do
        if sameColor(color,normal) or sameColor(color,EXTRA_HALLOWEEN[i]) then
            return target==HALLOWEEN_THEME and EXTRA_HALLOWEEN[i] or EXTRA_NORMAL[i]
        end
    end
end
local function isPurpleAccent(color)
    local h,s,v=Color3.toHSV(color)
    return s>.18 and v>.12 and h>=.70 and h<=.92
end
local function purpleToOrange(color)
    local _,s,v=Color3.toHSV(color)
    return Color3.fromHSV(.075,math.clamp(math.max(s,.72),0,1),
        math.clamp(math.max(v,.34),0,1))
end
